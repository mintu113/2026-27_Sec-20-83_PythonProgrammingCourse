# Matrix operations using nested lists

A = [[1, 2, 3],
     [4, 5, 6],
     [7, 8, 9]]

B = [[9, 8, 7],
     [6, 5, 4],
     [3, 2, 1]]

# Display matrices
print("Matrix A:")
for row in A:
    print(row)

print("Matrix B:")
for row in B:
    print(row)

# Matrix Addition
print("Matrix Addition:")
for i in range(3):
    for j in range(3):
        print(A[i][j] + B[i][j], end=" ")
    print()

# Matrix Subtraction
print("Matrix Subtraction:")
for i in range(3):
    for j in range(3):
        print(A[i][j] - B[i][j], end=" ")
    print()

# Matrix Multiplication
print("Matrix Multiplication:")
for i in range(3):
    for j in range(3):
        sum = 0
        for k in range(3):
            sum += A[i][k] * B[k][j]
        print(sum, end=" ")
    print()

# Matrix Transpose
print("Transpose of Matrix A:")
for i in range(3):
    for j in range(3):
        print(A[j][i], end=" ")
    print()
