# Create a nested dictionary
students = {
    1: {
        "name": "Rahul",
        "marks": 85
    },
    2: {
        "name": "Priya",
        "marks": 90
    },
    3: {
        "name": "Arun",
        "marks": 78
    }
}

# Print student names and marks
print("Student Details:")

for roll_no, details in students.items():
    print("Roll Number:", roll_no)
    print("Name:", details["name"])
    print("Marks:", details["marks"])
    print()
