# Create a sample dictionary
student = {
    "name": "Rahul",
    "age": 20,
    "course": "Python"
}

# 1. keys() - Display all keys
print("Keys:", student.keys())

# 2. values() - Display all values
print("Values:", student.values())

# 3. items() - Display key-value pairs
print("Items:", student.items())

# 4. get() - Access a value using a key
print("Name:", student.get("name"))

# 5. update() - Update or add dictionary elements
student.update({"age": 21, "city": "Vijayawada"})
print("After update:", student)

# 6. pop() - Remove an element using its key
student.pop("course")
print("After pop:", student)
