text = "  Hello Python World  "

# Upper
print("Uppercase:", text.upper())

# Lower
print("Lowercase:", text.lower())

# Strip
print("Strip:", text.strip())

# Split
words = text.split()
print("Split:", words)

# Join
print("Join:", "-".join(words))

# Replace
print("Replace:", text.replace("Python", "Java"))

# Find
print("Find:", text.find("Python"))
