a = 10
b = 5
c = 2

# Demonstrating operator precedence
result1 = a + b * c
result2 = (a + b) * c
result3 = a - b / c

print("a + b * c =", result1)
print("(a + b) * c =", result2)
print("a - b / c =", result3)

# Demonstrating associativity
result4 = a - b - c
result5 = a ** b ** c

print("a - b - c =", result4)
print("a ** b ** c =", result5)
