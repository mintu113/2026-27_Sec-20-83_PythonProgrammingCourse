def simple_interest(principal, time, rate=5):
    si = (principal * time * rate) / 100
    return si

p = float(input("Enter principal amount: "))
t = float(input("Enter time in years: "))

# Calling function with default rate
print("Simple Interest with default rate (5%) =", simple_interest(p, t))

# Calling function with explicit rate
r = float(input("Enter rate of interest: "))
print("Simple Interest with given rate =", simple_interest(p, t, r))
